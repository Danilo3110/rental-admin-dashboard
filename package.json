{
  "name": "demo-dashboard-breza-admin",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Demo admin dashboard for managing holiday rental reservations (React, Redux Toolkit, MUI, Chart.js).",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 5182 --strictPort",
    "build": "vite build",
    "preview": "vite preview --host 127.0.0.1 --port 5183 --strictPort",
    "test": "vitest run",
    "format": "prettier --write src *.json *.js *.html *.md",
    "build:pages": "vite build --base=/rental-admin-dashboard/ && node scripts/prepare-pages.mjs --spa",
    "deploy": "npm run build:pages && gh-pages -d dist --dotfiles -m \"Deploy site\" -u \"Danilo Lukić <lukic3.dev@gmail.com>\""
  },
  "dependencies": {
    "@emotion/react": "11.14.0",
    "@emotion/styled": "11.14.1",
    "@fontsource-variable/inter": "5.3.0",
    "@mui/icons-material": "9.6.0",
    "@mui/material": "9.6.0",
    "@reduxjs/toolkit": "2.15.0",
    "chart.js": "4.6.2",
    "formik": "2.4.9",
    "react": "19.3.1",
    "react-chartjs-2": "5.3.1",
    "react-dom": "19.3.1",
    "react-redux": "9.3.1",
    "react-router": "8.5.3"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "6.3.0",
    "gh-pages": "6.3.0",
    "prettier": "3.10.1",
    "vite": "8.3.8",
    "vitest": "5.1.1"
  }
}
